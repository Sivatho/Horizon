{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Fetch Policy Status Response",
    "type": "object",
    "properties": {
        "succeeded": {
            "type": "boolean"
        },
        "message": {
            "type": [ "string", "null" ]
        },
        "errors": {
            "type": [ "string", "null" ]
        },
        "data": {
            "type": "object",
            "properties": {
                "legacyPolicyNo": { "type": "string" },
                "policyNo": { "type": "integer" },
                "status": { "type": "string" },
                "statusCD": { "type": "integer" },
                "statusDate": {
                    "type": "string",
                    "format": "date-time"
                }
            },
            "required": [
                "legacyPolicyNo",
                "policyNo",
                "status",
                "statusCD",
                "statusDate"
            ]
        }
    },
    "required": [ "succeeded", "data" ]
}