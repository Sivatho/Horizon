{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/payment-response.schema.json",
  "title": "Policy Lookup Response",
  "type": "object",
  "additionalProperties": false,
  "required": [ "success", "message", "result" ],
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Indicates whether the overall API call was successful."
    },
    "message": {
      "type": [ "string", "null" ],
      "description": "Optional message for the overall response. Can be null."
    },
    "result": {
      "type": "array",
      "description": "List of result blocks returned by the API.",
      "items": {
        "$ref": "#/$defs/ResultItem"
      }
    }
  },
  "$defs": {
    "ResultItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "success", "data", "message" ],
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Indicates if the result item operation was successful."
        },
        "message": {
          "type": "string",
          "description": "Message associated with this result item."
        },
        "data": {
          "type": "array",
          "description": "Array of data entries describing policy/payment details.",
          "items": {
            "$ref": "#/$defs/DataItem"
          }
        }
      }
    },
    "DataItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "ifaBusinessFeeIncluded",
        "success",
        "message",
        "status",
        "payerIdentityNumber",
        "payerMobileTelephoneNumber",
        "policyNumber",
        "createdAt",
        "mandateType"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "description": "Payment amount. Use number to allow decimals."
        },
        "ifaBusinessFeeIncluded": {
          "type": "boolean",
          "description": "Whether the IFA business fee is included."
        },
        "success": {
          "type": "boolean",
          "description": "Indicates if the specific data item operation was successful."
        },
        "message": {
          "type": "string",
          "description": "Message describing the data item status or error."
        },
        "status": {
          "type": "string",
          "description": "Machine-readable status of the operation (e.g., 'NotAllowed').",
          "examples": [ "NotAllowed" ]
        },
        "payerIdentityNumber": {
          "type": "string",
          "description": "Payer's ID number. May be empty if not provided."
        },
        "payerMobileTelephoneNumber": {
          "type": "string",
          "description": "Payer's mobile number as a string to preserve formatting."
        },
        "policyNumber": {
          "type": "string",
          "description": "Policy number string."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp in ISO 8601 format."
        },
        "mandateType": {
          "type": "string",
          "description": "Mandate type code represented as a string.",
          "examples": [ "0" ]
        }
      }
    }
  },
  "examples": [
    {
      "success": true,
      "message": null,
      "result": [
        {
          "success": true,
          "data": [
            {
              "amount": 0,
              "ifaBusinessFeeIncluded": false,
              "success": false,
              "message": "Policy '204801' does not exist on PollyC.",
              "status": "NotAllowed",
              "payerIdentityNumber": "",
              "payerMobileTelephoneNumber": "",
              "policyNumber": "204801",
              "createdAt": "0001-01-01T00:00:00",
              "mandateType": "0"
            }
          ],
          "message": "Success"
        }
      ]
    }
  ]
}
``
