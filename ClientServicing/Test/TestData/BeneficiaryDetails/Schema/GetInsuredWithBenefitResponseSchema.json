{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Get Insured With Benefit Response JSON Schema",
    "type": "object",
    "properties": {
        "succeeded": {
            "type": "boolean"
        },
        "message": {
            "type": [ "string", "null" ]
        },
        "errors": {
            "type": [ "string", "null" ]
        },
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "benefitID": {
                        "type": "integer"
                    },
                    "benefitCover": {
                        "type": "number"
                    }
                },
                "required": [ "benefitID", "benefitCover" ],
                "additionalProperties": false
            }
        }
    },
    "required": [ "succeeded", "message", "errors", "data" ],
    "additionalProperties": false
}
